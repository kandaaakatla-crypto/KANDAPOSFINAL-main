{
  "hosting": {
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "kanda-pos-backend",
          "region": "asia-south1"
        }
      },
      { "source": "/owner", "destination": "/index.html" },
      { "source": "/owner/**", "destination": "/index.html" },
      { "source": "/biz", "destination": "/index.html" },
      { "source": "/biz/**", "destination": "/index.html" },
      { "source": "/kds", "destination": "/index.html" },
      { "source": "/kds/**", "destination": "/index.html" },
      { "source": "/display", "destination": "/index.html" },
      { "source": "/packing", "destination": "/index.html" },
      { "source": "/order/**", "destination": "/index.html" },
      { "source": "/loyalty/**", "destination": "/index.html" },
      { "source": "/driver", "destination": "/index.html" },
      { "source": "/", "destination": "/index.html" },
      { "source": "/start", "destination": "/index.html" },
      { "source": "/privacy", "destination": "/privacy.html" },
      { "source": "/terms", "destination": "/terms.html" },
      { "source": "/login", "destination": "/index.html" },
      { "source": "/clock", "destination": "/index.html" },
      { "source": "/pos", "destination": "/index.html" },
      { "source": "/orders", "destination": "/index.html" },
      { "source": "/tables", "destination": "/index.html" },
      { "source": "/menu", "destination": "/index.html" },
      { "source": "/dispatch", "destination": "/index.html" },
      { "source": "/workforce", "destination": "/index.html" },
      {
        "source": "**",
        "run": {
          "serviceId": "kanda-pos-backend",
          "region": "asia-south1"
        }
      }
    ],
    "headers": [
      {
        "source": "/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  }
}
